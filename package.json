{
  "name": "linspector",
  "version": "1.0.0",
  "description": "Glassmorphic Fetch and XHR interceptor with an Apple HIG inspired inspector panel.",
  "license": "MIT",
  "author": {
    "name": "liwidale",
    "url": "https://github.com/liwidale"
  },
  "homepage": "https://github.com/liwidale/linspector",
  "repository": {
    "type": "git",
    "url": "https://github.com/liwidale/linspector.git"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^4.1.10"
  }
}
